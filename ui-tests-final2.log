+   resumeFromBacklogPending?: boolean;
+   onResumeAssignee?: () => Promise<void> | void;
+   resumeAssigneePending?: boolean;
+   onTryAgainNoLiveExecutionPath?: () => Promise<void> | void;
+   tryAgainNoLiveExecutionPathPending?: boolean;
